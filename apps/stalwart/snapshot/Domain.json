{
  "@type": "upsert",
  "object": "Domain",
  "matchOn": ["name"],
  "value": {
    "domain-mail": {
      "aliases": { "mikuc.at": true },
      "allowRelaying": false,
      "allowScimProvisioning": false,
      "catchAllAddress": null,
      "certificateManagement": { "@type": "Manual" },
      "description": null,
      "directoryId": null,
      "dkimManagement": {
        "@type": "Automatic",
        "algorithms": { "Dkim1Ed25519Sha256": true, "Dkim1RsaSha256": true },
        "deleteAfter": 2592000000,
        "retireAfter": 604800000,
        "rotateAfter": 7776000000,
        "selectorTemplate": "v{version}-{algorithm}-{date-%Y%m%d}"
      },
      "dnsManagement": {
        "@type": "Automatic",
        "dnsServerId": "#dnsserver-cloudflare",
        "origin": null,
        "publishRecords": {
          "autoConfig": true,
          "autoConfigLegacy": true,
          "autoDiscover": true,
          "caa": true,
          "dkim": true,
          "dmarc": true,
          "mtaSts": true,
          "mx": true,
          "spf": true,
          "srv": true,
          "tlsRpt": true
        }
      },
      "enable": true,
      "logo": null,
      "memberTenantId": null,
      "name": "mikucat.me",
      "reportAddressUri": "mailto:postmaster",
      "subAddressing": { "@type": "Enabled" }
    }
  }
}
